{
  "name": "stagemic",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~58.0.26",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/audio/*.test.ts src/pwa/*.test.ts",
    "export:web": "expo export --platform web",
    "test:dsp": "modules/karaoke-audio/core/gradlew -p modules/karaoke-audio/core test --no-daemon",
    "test:native": "mkdir -p modules/karaoke-audio/android/build && ${CXX:-g++} -std=c++17 -pthread -I modules/karaoke-audio/android/src/main/cpp -o modules/karaoke-audio/android/build/native-test modules/karaoke-audio/android/src/main/cpp/test/dsp_test.cpp && modules/karaoke-audio/android/build/native-test",
    "lint": "expo lint"
  },
  "private": true
}
